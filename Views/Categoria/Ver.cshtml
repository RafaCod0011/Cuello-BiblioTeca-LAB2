@model Cuello_BiblioTeca_LAB2.Models.Categoria

@{
    ViewData["Title"] = "Detalles de la Categoría";
}

<section class="details-page">
    <div class="details-card">
        <header class="edit-card-header">
            <div class="edit-icon" aria-hidden="true"><i class="fa-solid fa-tags"></i></div>
            <div>
                <p class="edit-eyebrow">Catálogo</p>
                <h1>Detalles de la categoría</h1>
                <p class="edit-description">Información de la categoría seleccionada.</p>
            </div>
        </header>

        <div class="row details-layout">
            <div class="col-md-12">
                <dl class="details-list">
                    <div class="details-row">
                        <dt>@Html.DisplayNameFor(m => m.IdCategoria)</dt>
                        <dd>@Html.DisplayFor(m => m.IdCategoria)</dd>
                    </div>
                    <div class="details-row">
                        <dt>@Html.DisplayNameFor(m => m.Nombre)</dt>
                        <dd>@Html.DisplayFor(m => m.Nombre)</dd>
                    </div>
                    <div class="details-row">
                        <dt>@Html.DisplayNameFor(m => m.Descripcion)</dt>
                        <dd>@(Model.Descripcion ?? "—")</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="details-actions">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left me-2"></i>Volver a la lista
            </a>
            <a asp-action="Edit" asp-route-id="@Model.IdCategoria" class="btn btn-primary">
                <i class="fa-solid fa-pen me-2"></i>Editar
            </a>
        </div>
    </div>
</section>