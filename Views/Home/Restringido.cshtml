@{
    ViewData["Title"] = "Acceso Denegado";
}

<section class="access-denied-page">
    <div class="access-denied-card">
        <div class="access-denied-icon" aria-hidden="true">
            <i class="fa-solid fa-ban"></i>
        </div>
        <h1>Acceso denegado</h1>
        <p class="access-denied-message">
            No tienes permisos suficientes para realizar esta accion.
        </p>
        <div class="access-denied-actions">
            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Volver atrás
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="fa-solid fa-house"></i> Ir al inicio
            </a>
        </div>
    </div>
</section>