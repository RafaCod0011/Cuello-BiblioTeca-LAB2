@model IEnumerable<Cuello_BiblioTeca_LAB2.Models.Multa>

@{
    ViewData["Title"] = "Multas";
    var Pagina = (int)(ViewBag.Pagina ?? 1);
    var TotalPaginas = (int)(ViewBag.TotalPaginas ?? 1);
    var TotalRegistros = (int)(ViewBag.TotalRegistros ?? 0);
    var busquedaActual = ViewBag.Busqueda as string;
    var estadoActual = ViewBag.Estado as string;
    var hayFiltros = !string.IsNullOrWhiteSpace(busquedaActual) || !string.IsNullOrWhiteSpace(estadoActual);

    int desde = Math.Max(1, Math.Min(Pagina - 2, TotalPaginas - 4));
    int hasta = Math.Min(TotalPaginas, desde + 4);
}

<section class="index-page">
    <header class="index-header">
        <div>
            <p class="index-eyebrow">Gestión</p>
            <h1>Multas</h1>
            <p class="index-description">Administre las penalizaciones por atraso.</p>
        </div>
    </header>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ViewBag.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="index-table-wrapper mb-3" style="padding: 1rem;">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Búsqueda</label>
                <input type="text" name="busqueda" value="@busquedaActual" class="form-control"
                       placeholder="Socio, DNI o título..." />
            </div>
            <div class="col-md-3">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-control">
                    <option value="">Todos</option>
                    <option value="Pendiente" selected="@(estadoActual == "Pendiente")">Pendiente</option>
                    <option value="Pagada" selected="@(estadoActual == "Pagada")">Pagada</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-success w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Buscar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="fa-solid fa-eraser me-1"></i> Limpiar
                </a>
            </div>
        </form>
        @if (hayFiltros)
        {
            <small class="text-muted d-block mt-2">
                Mostrando @TotalRegistros resultado(s) para los filtros aplicados.
            </small>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            @(hayFiltros
                ? "No se encontraron multas con los filtros aplicados."
                : "No hay multas registradas.")
        </div>
    }
    else
    {
        <div class="index-table-wrapper">
            <table class="table index-table">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.IdMulta)</th>
                        <th>Socio</th>
                        <th>Libro</th>
                        <th>@Html.DisplayNameFor(m => m.Importe)</th>
                        <th>@Html.DisplayNameFor(m => m.Motivo)</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(m => item.IdMulta)</td>
                            <td>
                                @(item.SocioNombre ?? "—")
                                <br />
                                <small class="text-muted">DNI: @(item.SocioDni ?? "—")</small>
                            </td>
                            <td>@(item.LibroTitulo ?? "—")</td>
                            <td>@item.Importe.ToString("C", new System.Globalization.CultureInfo("es-AR"))</td>
                            <td>@(item.Motivo ?? "—")</td>
                            <td>
                                @if (item.Pagada)
                                {
                                    <span class="badge bg-success">Pagada</span>
                                    @if (item.FechaPagada.HasValue)
                                    {
                                        <br />
                                        <small class="text-muted">@item.FechaPagada.Value.ToString("dd/MM/yyyy")</small>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-danger">Pendiente</span>
                                }
                            </td>
                            <td>
                                <div class="index-actions" role="group">
                                    <a class="btn btn-info btn-sm" asp-action="Ver" asp-route-id="@item.IdMulta" title="Ver">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    @if (!item.Pagada)
                                    {
                                        <a class="btn btn-success btn-sm" asp-action="Pagar" asp-route-id="@item.IdMulta"
                                           title="Registrar pago">
                                            <i class="fa-solid fa-dollar-sign"></i>
                                        </a>
                                    }
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a class="btn btn-danger btn-sm" asp-action="Eliminar" asp-route-id="@item.IdMulta"
                                           title="Eliminar">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        @if (TotalPaginas > 1)
        {
            <nav aria-label="Paginación de multas">
                <ul class="pagination justify-content-center">
                    @if (Pagina > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(Pagina - 1)"
                               asp-route-busqueda="@busquedaActual" asp-route-estado="@estadoActual">
                                <i class="fa-solid fa-angles-left"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fa-solid fa-angles-left"></i></span>
                        </li>
                    }

                    @if (desde > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pagina="1" asp-route-busqueda="@busquedaActual"
                               asp-route-estado="@estadoActual">1</a>
                        </li>
                        @if (desde > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    @for (int i = desde; i <= hasta; i++)
                    {
                        <li class="page-item @(i == Pagina ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-busqueda="@busquedaActual"
                               asp-route-estado="@estadoActual">@i</a>
                        </li>
                    }

                    @if (hasta < TotalPaginas)
                    {
                        @if (hasta < TotalPaginas - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@TotalPaginas"
                               asp-route-busqueda="@busquedaActual" asp-route-estado="@estadoActual">@TotalPaginas</a>
                        </li>
                    }

                    @if (Pagina < TotalPaginas)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(Pagina + 1)"
                               asp-route-busqueda="@busquedaActual" asp-route-estado="@estadoActual">
                                <i class="fa-solid fa-angles-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fa-solid fa-angles-right"></i></span>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</section>