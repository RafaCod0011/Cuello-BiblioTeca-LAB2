@model Cuello_BiblioTeca_LAB2.Models.Ejemplar

@{
    ViewData["Title"] = "Editar Ejemplar";
}

<section class="edit-page">
    <div class="edit-card">
        <header class="edit-card-header">
            <div class="edit-icon" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></div>
            <div>
                <p class="edit-eyebrow">Inventario</p>
                <h1>Editar ejemplar</h1>
                <p class="edit-description">Modifique los datos del ejemplar.</p>
            </div>
        </header>

        <form asp-action="Edit" asp-route-id="@Model.CodigoEjemplar" class="edit-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CodigoEjemplar" />

            <div class="edit-fields">
                <div class="form-group edit-email-field">
                    <label asp-for="ISBN" class="control-label"></label>
                    <select asp-for="ISBN" class="form-control" id="libroSelect">
                        @if (ViewBag.LibroId != null)
                        {
                            <option value="@ViewBag.LibroId" selected>@ViewBag.LibroSeleccionado</option>
                        }
                    </select>
                    <span asp-validation-for="ISBN" class="text-danger"></span>
                </div>

                <div class="form-group edit-email-field">
                    <label asp-for="Localizacion" class="control-label"></label>
                    <input asp-for="Localizacion" class="form-control" />
                    <span asp-validation-for="Localizacion" class="text-danger"></span>
                </div>

                <div class="form-group edit-email-field">
                    <label asp-for="Estado" class="control-label"></label>
                    <select asp-for="Estado" class="form-control">
                        <option value="Disponible" selected="@(Model.Estado == "Disponible")">Disponible</option>
                        <option value="Prestado" selected="@(Model.Estado == "Prestado")">Prestado</option>
                        <option value="Reservado" selected="@(Model.Estado == "Reservado")">Reservado</option>
                        <option value="Dañado" selected="@(Model.Estado == "Dañado")">Dañado</option>
                        <option value="Baja" selected="@(Model.Estado == "Baja")">Baja</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
            </div>

            <div class="edit-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-success">
                    <i class="fa-solid fa-save" aria-hidden="true"></i> Guardar
                </button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $('#libroSelect').select2({
                language: 'es',
                theme: 'bootstrap-5',
                placeholder: 'Buscar libro...',
                minimumInputLength: 2,
                ajax: {
                    url: '@Url.Action("Buscar", "Libro")',
                    dataType: 'json',
                    delay: 250,
                    data: (params) => ({ term: params.term }),
                    processResults: (data) => ({ results: data })
                }
            });
        });
    </script>
}