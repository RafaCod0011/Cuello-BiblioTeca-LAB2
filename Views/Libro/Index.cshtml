@model IEnumerable<Cuello_BiblioTeca_LAB2.Models.Libro>

@{
    ViewData["Title"] = "Libros";
    var Pagina = (int)(ViewBag.Pagina ?? 1);
    var TotalPaginas = (int)(ViewBag.TotalPaginas ?? 1);
    var TotalRegistros = (int)(ViewBag.TotalRegistros ?? 0);
    var categorias = (IList<Cuello_BiblioTeca_LAB2.Models.Categoria>)ViewBag.Categorias
                     ?? new List<Cuello_BiblioTeca_LAB2.Models.Categoria>();
    
    var busquedaActual = ViewBag.Busqueda as string;
    var autorActual = ViewBag.Autor as string;
    var categoriaActual = ViewBag.IdCategoria as int?;
    var minPaginasActual = ViewBag.MinPaginas as int?;
    var maxPaginasActual = ViewBag.MaxPaginas as int?;
    
    var hayFiltros = !string.IsNullOrWhiteSpace(busquedaActual)
                     || !string.IsNullOrWhiteSpace(autorActual)
                     || categoriaActual.HasValue
                     || minPaginasActual.HasValue
                     || maxPaginasActual.HasValue;

    int desde = Math.Max(1, Math.Min(Pagina - 2, TotalPaginas - 4));
    int hasta = Math.Min(TotalPaginas, desde + 4);
}

<section class="index-page">
    <header class="index-header">
        <div>
            <p class="index-eyebrow">Catálogo</p>
            <h1>Libros</h1>
            <p class="index-description">Administre el catálogo de libros del sistema.</p>
        </div>
        @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
        {
            <a class="btn btn-success index-create-button" asp-action="Create">
                <i class="fa-solid fa-plus" aria-hidden="true"></i><span>Nuevo libro</span>
            </a>
        }
    </header>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ViewBag.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="index-table-wrapper mb-3" style="padding: 1rem;">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Título o ISBN</label>
                <input type="text" name="busqueda" value="@busquedaActual" class="form-control"
                       placeholder="Buscar título..." />
            </div>
            <div class="col-md-2">
                <label class="form-label">Autor</label>
                <input type="text" name="autor" value="@autorActual" class="form-control" placeholder="Ej: Orwell" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Categoría</label>
                <select name="idCategoria" id="filtroCategoria" class="form-control">
                    @if (categoriaActual.HasValue)
                    {
                        <option value="@categoriaActual" selected>@ViewBag.CategoriaNombre</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label">Págs. mín</label>
                <input type="number" name="minPaginas" value="@minPaginasActual" min="1" class="form-control" />
            </div>
            <div class="col-md-1">
                <label class="form-label">Págs. máx</label>
                <input type="number" name="maxPaginas" value="@maxPaginasActual" min="1" class="form-control" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-success w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Buscar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="fa-solid fa-eraser me-1"></i> Limpiar
                </a>
            </div>
        </form>
        @if (hayFiltros)
        {
            <small class="text-muted d-block mt-2">
                Mostrando @TotalRegistros resultado(s) para los filtros aplicados.
            </small>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            @(hayFiltros
                ? "No se encontraron libros con los filtros aplicados."
                : "No hay libros registrados.")
        </div>
    }
    else
    {
        <div class="property-grid">
            @foreach (var item in Model)
            {
                <article class="property-card">
                    <div class="property-cover">
                        @if (!string.IsNullOrEmpty(item.Portada))
                        {
                            <img src="@item.Portada" alt="Portada de @item.Titulo" />
                        }
                        else
                        {
                            <div class="property-cover-placeholder">
                                <i class="fa-solid fa-book"></i>
                                <span>Sin portada</span>
                            </div>
                        }
                        <span class="property-status badge @(item.EjemplaresDisponibles > 0 ? "bg-success" : "bg-secondary")">
                            @item.EjemplaresDisponibles disponibles
                        </span>
                    </div>
                    <div class="property-content">
                        <div class="property-heading">
                            <span class="property-code">ISBN: @item.ISBN</span>
                            <h2>@item.Titulo</h2>
                        </div>
                        <dl class="property-data">
                            <div>
                                <dt>Categoría</dt>
                                <dd>@(item.CategoriaNombre ?? "Sin categoría")</dd>
                            </div>
                            <div>
                                <dt>Autor(es)</dt>
                                <dd>@(item.AutoresTexto ?? "Sin autores")</dd>
                            </div>
                            <div>
                                <dt>Año</dt>
                                <dd>@(item.AnioPublicacion?.ToString() ?? "—")</dd>
                            </div>
                            <div>
                                <dt>Páginas</dt>
                                <dd>@(item.NroPaginas?.ToString() ?? "—")</dd>
                            </div>
                            <div>
                                <dt>Editorial</dt>
                                <dd>@(item.Editorial ?? "—")</dd>
                            </div>
                            <div>
                                <dt>Ejemplares</dt>
                                <dd>@item.TotalEjemplares (@item.EjemplaresDisponibles disp.)</dd>
                            </div>
                        </dl>
                        <div class="property-actions">
                            <a class="btn btn-info btn-sm" asp-action="Ver" asp-route-id="@item.ISBN" title="Ver">
                                <i class="fa-solid fa-eye"></i><span>Ver</span>
                            </a>
                            @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
                            {
                                <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@item.ISBN" title="Editar">
                                    <i class="fa-solid fa-pen"></i><span>Editar</span>
                                </a>
                            }
                            @if (User.IsInRole("Administrador"))
                            {
                                <a class="btn btn-danger btn-sm" asp-action="Eliminar" asp-route-id="@item.ISBN" title="Eliminar">
                                    <i class="fa-solid fa-trash-can"></i>
                                </a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>

        <!-- Paginación optimizada con filtros -->
        @if (TotalPaginas > 1)
        {
            <nav aria-label="Paginación de libros">
                <ul class="pagination justify-content-center">
                    @if (Pagina > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(Pagina - 1)"
                               asp-route-busqueda="@busquedaActual" asp-route-autor="@autorActual"
                               asp-route-idCategoria="@categoriaActual" asp-route-minPaginas="@minPaginasActual"
                               asp-route-maxPaginas="@maxPaginasActual">
                                <i class="fa-solid fa-angles-left"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fa-solid fa-angles-left"></i></span>
                        </li>
                    }

                    @if (desde > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pagina="1" asp-route-busqueda="@busquedaActual"
                               asp-route-autor="@autorActual" asp-route-idCategoria="@categoriaActual"
                               asp-route-minPaginas="@minPaginasActual" asp-route-maxPaginas="@maxPaginasActual">1</a>
                        </li>
                        @if (desde > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    @for (int i = desde; i <= hasta; i++)
                    {
                        <li class="page-item @(i == Pagina ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-busqueda="@busquedaActual"
                               asp-route-autor="@autorActual" asp-route-idCategoria="@categoriaActual"
                               asp-route-minPaginas="@minPaginasActual" asp-route-maxPaginas="@maxPaginasActual">@i</a>
                        </li>
                    }

                    @if (hasta < TotalPaginas)
                    {
                        @if (hasta < TotalPaginas - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@TotalPaginas"
                               asp-route-busqueda="@busquedaActual" asp-route-autor="@autorActual"
                               asp-route-idCategoria="@categoriaActual" asp-route-minPaginas="@minPaginasActual"
                               asp-route-maxPaginas="@maxPaginasActual">@TotalPaginas</a>
                        </li>
                    }

                    @if (Pagina < TotalPaginas)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@(Pagina + 1)"
                               asp-route-busqueda="@busquedaActual" asp-route-autor="@autorActual"
                               asp-route-idCategoria="@categoriaActual" asp-route-minPaginas="@minPaginasActual"
                               asp-route-maxPaginas="@maxPaginasActual">
                                <i class="fa-solid fa-angles-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fa-solid fa-angles-right"></i></span>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            
            $('#filtroCategoria').select2({
                language: 'es',
                theme: 'bootstrap-5',
                placeholder: 'Buscar categoría...',
                allowClear: true,
                minimumInputLength: 1,
                ajax: {
                    url: '@Url.Action("Buscar", "Categoria")',
                    dataType: 'json',
                    delay: 250,
                    data: (params) => ({ term: params.term }),
                    processResults: (data) => ({ results: data })
                }
            });
        });
    </script>
}