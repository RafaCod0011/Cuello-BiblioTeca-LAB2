@model Cuello_BiblioTeca_LAB2.Models.Libro

@{
    ViewData["Title"] = "Eliminar Libro";
}

<section class="delete-page">
    <div class="delete-card">
        <header class="delete-card-header">
            <div class="delete-icon" aria-hidden="true"><i class="fa-solid fa-book"></i></div>
            <div>
                <p class="delete-eyebrow">Catálogo</p>
                <h1>Eliminar libro</h1>
                <p class="delete-question">¿Está seguro de que desea eliminar este libro?</p>
            </div>
        </header>

        <div class="delete-details">
            <dl>
                <div class="delete-detail">
                    <dt>ISBN</dt>
                    <dd>@Html.DisplayFor(m => m.ISBN)</dd>
                </div>
                <div class="delete-detail">
                    <dt>Título</dt>
                    <dd>@Html.DisplayFor(m => m.Titulo)</dd>
                </div>
                <div class="delete-detail">
                    <dt>Editorial</dt>
                    <dd>@(Model.Editorial ?? "—")</dd>
                </div>
                <div class="delete-detail">
                    <dt>Año</dt>
                    <dd>@(Model.AnioPublicacion?.ToString() ?? "—")</dd>
                </div>
            </dl>
        </div>

        <div class="delete-actions">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <form asp-action="Eliminar" asp-route-id="@Model.ISBN" method="post">
                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i> Eliminar
                </button>
            </form>
        </div>
    </div>
</section>