@model Cuello_BiblioTeca_LAB2.Models.Libro

@{
    ViewData["Title"] = "Detalles del Libro";
    var totalEjemplares = (int?)ViewBag.TotalEjemplares ?? 0;
    var ejemplaresDisponibles = (int?)ViewBag.EjemplaresDisponibles ?? 0;
}

<section class="details-page">
    <div class="details-card">
        <header class="edit-card-header">
            <div class="edit-icon" aria-hidden="true"><i class="fa-solid fa-book"></i></div>
            <div>
                <p class="edit-eyebrow">Catálogo</p>
                <h1>@Model.Titulo</h1>
                <p class="edit-description">ISBN: @Model.ISBN</p>
            </div>
        </header>

        <div class="row details-layout">
            <div class="col-md-4 text-center">
                @if (!string.IsNullOrEmpty(Model.Portada))
                {
                    <img src="@Model.Portada" alt="Portada de @Model.Titulo"
                         style="max-width: 100%; max-height: 400px; object-fit: cover;" class="img-thumbnail" />
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center"
                         style="height: 300px; background: #f0f0f0; border-radius: 8px;">
                        <i class="fa-solid fa-book fa-4x text-muted"></i>
                        <p class="text-muted mt-2">Sin portada</p>
                    </div>
                }
            </div>
            <div class="col-md-8">
                <dl class="details-list">
                    <div class="details-row">
                        <dt>@Html.DisplayNameFor(m => m.Titulo)</dt>
                        <dd>@Html.DisplayFor(m => m.Titulo)</dd>
                    </div>
                    <div class="details-row">
                        <dt>@Html.DisplayNameFor(m => m.NroPaginas)</dt>
                        <dd>@(Model.NroPaginas?.ToString() ?? "—")</dd>
                    </div>
                    <div class="details-row">
                        <dt>@Html.DisplayNameFor(m => m.Editorial)</dt>
                        <dd>@(Model.Editorial ?? "—")</dd>
                    </div>
                    <div class="details-row">
                        <dt>@Html.DisplayNameFor(m => m.AnioPublicacion)</dt>
                        <dd>@(Model.AnioPublicacion?.ToString() ?? "—")</dd>
                    </div>
                    <div class="details-row">
                        <dt>Categoría</dt>
                        <dd>@(Model.CategoriaNombre ?? "Sin categoría")</dd>
                    </div>
                    <div class="details-row">
                        <dt>Autores</dt>
                        <dd>@(Model.AutoresTexto ?? "Sin autores")</dd>
                    </div>
                    <div class="details-row">
                        <dt>Ejemplares</dt>
                        <dd>
                            <span class="badge bg-primary">@totalEjemplares totales</span>
                            <span class="badge @(ejemplaresDisponibles > 0 ? "bg-success" : "bg-secondary")">
                                @ejemplaresDisponibles disponibles
                            </span>
                        </dd>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Sinopsis))
                    {
                        <div class="details-row">
                            <dt>Sinopsis</dt>
                            <dd>@Model.Sinopsis</dd>
                        </div>
                    }
                </dl>
            </div>
        </div>

        <div class="details-actions">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left me-2"></i>Volver a la lista
            </a>
            @if (User.IsInRole("Administrador") || User.IsInRole("Bibliotecario"))
            {
                <a asp-action="Edit" asp-route-id="@Model.ISBN" class="btn btn-primary">
                    <i class="fa-solid fa-pen me-2"></i>Editar
                </a>
            }
        </div>
    </div>
</section>