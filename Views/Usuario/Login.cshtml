@model Cuello_BiblioTeca_LAB2.Models.LoginView

@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="login-page">
    <div class="login-card">
        <div class="login-illustration">
            <div class="login-badge">
                <i class="fa-solid fa-house-user" aria-hidden="true"></i>
            </div>
            <h2>Bienvenido</h2>
            <p>Ingresá tus datos para continuar.</p>
        </div>

        <div class="login-panel">
            <header class="login-header">
                <p class="login-eyebrow">Acceso</p>
                <h1>Iniciar sesión</h1>
            </header>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="login-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Usuario" class="control-label"></label>
                    <input asp-for="Usuario" class="form-control" placeholder="usuario@correo.com" />
                    <span asp-validation-for="Usuario" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Clave" class="control-label"></label>
                    <input asp-for="Clave" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Clave" class="text-danger"></span>
                </div>

                <div class="login-actions">
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i>Ingresar
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}